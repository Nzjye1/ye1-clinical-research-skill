{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "description": "Dynamic row names MUST exactly follow the fields declaration at runtime; unknown row keys are rejected."
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "outcome": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "event": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "non_event": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "prediction_time": {
          "type": "string",
          "minLength": 1
        },
        "outcome_window": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "type": {
                    "const": "number"
                  },
                  "available_at_prediction": {
                    "const": true
                  }
                },
                "required": [
                  "name",
                  "type",
                  "available_at_prediction"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "type": {
                    "const": "category"
                  },
                  "levels": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "minItems": 2
                  },
                  "available_at_prediction": {
                    "const": true
                  }
                },
                "required": [
                  "name",
                  "type",
                  "levels",
                  "available_at_prediction"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "split": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "random",
                "group",
                "temporal"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "test_fraction": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.5
            },
            "group": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "time": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "label_available_time": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "method",
            "seed",
            "test_fraction"
          ],
          "additionalProperties": false
        },
        "missing": {
          "const": "train_median_mode"
        },
        "cv_folds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "bootstrap": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            }
          ]
        },
        "independent_subjects": {
          "const": true
        },
        "dca_thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "clinical_decision_threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "selection": {
          "const": "none"
        },
        "post_outcome_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "minItems": 0
        },
        "evaluation_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "calibration": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "none",
                "sigmoid"
              ]
            },
            "fraction": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "method",
            "fraction"
          ],
          "additionalProperties": false
        },
        "tuning": {
          "type": "object",
          "properties": {
            "metric": {
              "const": "log_loss"
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "n_estimators": {
                        "type": "number"
                      },
                      "max_depth": {
                        "type": "number"
                      },
                      "min_samples_leaf": {
                        "type": "number"
                      },
                      "max_features": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    },
                    "required": [
                      "n_estimators",
                      "max_depth",
                      "min_samples_leaf",
                      "max_features"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "max_iter": {
                        "type": "number"
                      },
                      "max_leaf_nodes": {
                        "type": "number"
                      },
                      "min_samples_leaf": {
                        "type": "number"
                      },
                      "learning_rate": {
                        "type": "number"
                      },
                      "l2_regularization": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "max_iter",
                      "max_leaf_nodes",
                      "min_samples_leaf",
                      "learning_rate",
                      "l2_regularization"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "metric",
            "candidates"
          ],
          "additionalProperties": false
        },
        "explanation": {
          "type": "object",
          "properties": {
            "permutation_repeats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "pdp_features": {
              "type": "array",
              "minItems": 0,
              "maxItems": 5,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            }
          },
          "required": [
            "permutation_repeats",
            "pdp_features"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "outcome",
        "event",
        "non_event",
        "cohort_id",
        "prediction_time",
        "outcome_window",
        "features",
        "split",
        "missing",
        "cv_folds",
        "bootstrap",
        "independent_subjects",
        "dca_thresholds",
        "clinical_decision_threshold",
        "selection",
        "calibration",
        "tuning",
        "explanation"
      ],
      "additionalProperties": false
    },
    "data_contract": {
      "type": "object",
      "properties": {
        "grain": {
          "const": "subject"
        },
        "subject_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "record_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "group_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_namespace": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "dtype": {
                "enum": [
                  "id",
                  "number",
                  "category",
                  "time"
                ]
              },
              "role": {
                "enum": [
                  "id",
                  "feature",
                  "outcome",
                  "split",
                  "time",
                  "label_time"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "occurred_at": {
                "type": "number"
              },
              "available_at": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "dtype",
              "role",
              "unit",
              "occurred_at",
              "available_at"
            ],
            "additionalProperties": false
          }
        },
        "independent_subjects": {
          "const": true
        },
        "time": {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "hour",
                "day"
              ]
            },
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "prediction_at": {
              "type": "number"
            },
            "outcome_start": {
              "type": "number"
            },
            "outcome_end": {
              "type": "number"
            },
            "analysis_as_of": {
              "type": "number"
            }
          },
          "required": [
            "unit",
            "origin",
            "prediction_at",
            "outcome_start",
            "outcome_end",
            "analysis_as_of"
          ],
          "additionalProperties": false
        },
        "missing": {
          "type": "object",
          "properties": {
            "strategy": {
              "const": "train_median_mode"
            },
            "fit_scope": {
              "enum": [
                "training_only",
                "frozen_only"
              ]
            }
          },
          "required": [
            "strategy",
            "fit_scope"
          ],
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            },
            "field": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "grain",
        "subject_key",
        "record_keys",
        "group_key",
        "identity_namespace",
        "fields",
        "independent_subjects",
        "time",
        "missing",
        "weights"
      ],
      "additionalProperties": false
    },
    "frozen_model_json": {
      "type": [
        "string",
        "null"
      ]
    },
    "explain_with_outcomes": {
      "type": "boolean"
    },
    "application_scope": {
      "enum": [
        "development",
        "external",
        "development_holdout"
      ]
    }
  },
  "required": [
    "rows",
    "spec",
    "data_contract",
    "frozen_model_json",
    "explain_with_outcomes",
    "application_scope"
  ],
  "additionalProperties": false
}