          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "missing_feature_excluded_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "analyzable_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "analyzable_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "analyzable_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "training_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "training_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "training_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "holdout_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "holdout_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "holdout_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_fit_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_fit_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_fit_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calibration_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calibration_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calibration_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
