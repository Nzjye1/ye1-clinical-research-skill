  "required": [
    "stage",
    "provider_version",
    "runtime",
    "counts",
    "fit_metadata",
    "bindings_checked",
    "model_refitted",
    "preprocessing_refitted",
    "calibration_refitted"
  ],
  "additionalProperties": false
}