          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evaluation_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evaluation_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evaluation_nonevents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fit_metadata": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "transformed_feature_count": {
              "type": "number"
            },
            "epv_status": {
              "type": "string"
            },
            "calibration": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string"
                },
                "sample": {
                  "type": "object",
                  "properties": {
                    "n": {
                      "type": "number"
                    },
                    "events": {
                      "type": "number"
                    },
                    "nonevents": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "n",
                    "events",
                    "nonevents"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "sample"
              ],
              "additionalProperties": false
            },
            "native_freeze_max_abs_difference": {
              "type": "number"
            },
            "early_stopping": {
              "type": "boolean"
            },
            "selected_parameters": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "n_estimators": {
                      "type": "number"
                    },
                    "max_depth": {
                      "type": "number"
                    },
                    "min_samples_leaf": {
                      "type": "number"
                    },
                    "max_features": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "required": [
                    "n_estimators",
                    "max_depth",
                    "min_samples_leaf",
                    "max_features"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "max_iter": {
                      "type": "number"
                    },
                    "max_leaf_nodes": {
                      "type": "number"
                    },
                    "min_samples_leaf": {
                      "type": "number"
                    },
                    "learning_rate": {
                      "type": "number"
                    },
                    "l2_regularization": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "max_iter",
                    "max_leaf_nodes",
                    "min_samples_leaf",
                    "learning_rate",
                    "l2_regularization"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "transformed_feature_count",
            "epv_status",
            "calibration",
            "native_freeze_max_abs_difference",
            "early_stopping",
            "selected_parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
