{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stage": {
      "type": "string"
    },
    "provider_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "numpy": {
          "type": "string"
        },
        "scipy": {
          "type": "string"
        },
        "statsmodels": {
          "type": "string"
        },
        "sklearn": {
          "type": "string"
        },
        "pandas": {
          "type": "string"
        }
      },
      "required": [
        "python",
        "numpy",
        "scipy",
        "statsmodels",
        "sklearn",
        "pandas"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "total_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_events": {
          "type": [
            "integer",
            "null"
          ],
