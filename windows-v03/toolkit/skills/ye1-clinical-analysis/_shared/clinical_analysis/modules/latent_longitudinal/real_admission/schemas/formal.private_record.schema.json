{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "individual_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_index": {
            "type": "integer"
          },
          "row_indices": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          },
          "partition": {
            "enum": [
              "training",
              "holdout",
              "external"
            ]
          },
          "class": {
            "type": "integer"
          },
          "posterior": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 6
          }
        },
        "required": [
          "unit_index",
          "row_indices",
          "partition",
          "class",
          "posterior"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "model_json",
    "model_sha256",
    "individual_results"
  ],
  "additionalProperties": false
}
