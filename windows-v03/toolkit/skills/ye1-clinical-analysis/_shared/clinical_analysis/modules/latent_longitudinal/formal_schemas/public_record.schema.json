                "holdout"
              ],
              "additionalProperties": false
            },
            "controls": {
              "type": "object",
              "properties": {
                "max_iter": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "tol": {
                  "type": "number",
                  "minimum": 1e-08,
                  "maximum": 1e-05
                },
                "stability_reps": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 30
                },
                "min_class_n": {
                  "const": 5
                },
                "min_class_fraction": {
                  "const": 0.05
                }
              },
              "required": [
                "max_iter",
                "tol",
                "stability_reps",
                "min_class_n",
                "min_class_fraction"
              ],
              "additionalProperties": false
            },
            "definition": {
              "type": "object",
              "properties": {
                "family": {
                  "enum": [
                    "lcga",
                    "growth_mixture"
                  ]
                },
                "time": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "origin": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 1e-12,
                      "maximum": 1000000000000.0
                    }
                  },
                  "required": [
                    "name",
                    "unit",
                    "origin",
                    "scale"
                  ],
                  "additionalProperties": false
                },
                "outcome": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "unit"
                  ],
                  "additionalProperties": false
                },
                "degree": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "random": {
                  "enum": [
                    "none",
                    "intercept",
                    "intercept_slope"
                  ]
                },
                "missing": {
                  "const": "observed_likelihood_mar"
                }
              },
              "required": [
                "family",
                "time",
                "outcome",
                "degree",
                "random",
                "missing"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "subject_id",
            "cohort_id",
            "candidate_k",
            "seed",
            "starts",
            "split",
            "controls",
            "definition"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "properties": {
            "model_family": {
              "enum": [
                "LCGA",
                "growth_mixture"
              ]
            },
            "trajectories": {
              "minItems": 2
            }
          }
        }
      }
    }
  ]
}
