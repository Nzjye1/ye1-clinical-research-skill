{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "owner",
    "language",
    "entrypoint",
    "projection_entrypoint",
    "provider_files",
    "dependencies",
    "methods",
    "shared_change_requests",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "clinical-module-integration@1.0"
    },
    "module_id": {
      "enum": [
        "mediation_matching",
        "latent_longitudinal",
        "nonlinear_prediction",
        "cox_evaluation_explanation"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "python",
        "R"
      ]
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "function"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        }
      }
    },
    "projection_entrypoint": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "function"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "function": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "role": {
            "enum": [
              "numerical_owner",
              "runtime",
              "validation_reference"
            ]
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "method_version",
          "operations",
          "numerical_owner",
          "schemas"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$",
            "maxLength": 120
          },
          "method_version": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 40
            }
          },
          "numerical_owner": {
            "type": "string",
            "minLength": 1
          },
          "schemas": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "payload",
              "diagnostics",
              "public_record",
              "private_record"
            ],
            "properties": {
              "payload": {
                "type": "string",
                "minLength": 1
              },
              "diagnostics": {
                "type": "string",
                "minLength": 1
              },
              "public_record": {
                "type": "string",
                "minLength": 1
              },
              "private_record": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "shared_change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "reason",
          "affected_methods",
          "required_regression"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "affected_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_regression": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
