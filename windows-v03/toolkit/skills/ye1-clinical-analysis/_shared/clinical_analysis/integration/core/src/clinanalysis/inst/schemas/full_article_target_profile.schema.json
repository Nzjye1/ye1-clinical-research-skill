{
  "additionalProperties": false,
  "properties": {
    "automatic_volume_gate_required": {
      "const": true,
      "default": true,
      "title": "Automatic Volume Gate Required",
      "type": "boolean"
    },
    "compact_article_allowed": {
      "const": false,
      "default": false,
      "title": "Compact Article Allowed",
      "type": "boolean"
    },
    "human_volume_detection_required": {
      "const": false,
      "default": false,
      "title": "Human Volume Detection Required",
      "type": "boolean"
    },
    "minimum_figure_count": {
      "default": 3,
      "minimum": 3,
      "title": "Minimum Figure Count",
      "type": "integer"
    },
    "minimum_table_count": {
      "default": 3,
      "minimum": 3,
      "title": "Minimum Table Count",
      "type": "integer"
    },
    "minimum_total_display_count": {
      "default": 6,
      "minimum": 6,
      "title": "Minimum Total Display Count",
      "type": "integer"
    },
    "profile_id": {
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "required_figure_roles": {
      "items": {
        "enum": [
          "COHORT_FLOW",
          "PRIMARY_EFFECT",
          "CLINICAL_DEEPENING",
          "CREDIBILITY"
