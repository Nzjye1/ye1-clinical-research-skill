{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/clinanalysis/formal-execution-v7-failure-receipt.schema.json",
  "title": "CVCC FORMAL V7 terminal execution failure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "status", "candidate_id", "binding",
    "attempt", "execution", "failure_diagnostic_sha256",
    "failure_diagnostic", "bootstrap", "downstream_status", "outputs",
    "privacy", "started_at", "failed_at", "next_responsible_actor"
  ],
  "properties": {
    "schema_version": {
      "const": "formal-execution-v7-failure-receipt@1.0.0"
    },
    "receipt_id": {
      "const": "RECEIPT.CVCC-PRED-ISO-001.FORMAL-EXECUTION.V7"
    },
    "status": {
      "const": "FAILED_NO_RETRY_V7_AUTHORIZATION_CONSUMED"
    },
    "candidate_id": {"const": "CVCC-PRED-ISO-001"},
    "binding": {"$ref": "#/$defs/binding"},
    "attempt": {"$ref": "#/$defs/attempt"},
    "execution": {"$ref": "#/$defs/execution"},
    "failure_diagnostic_sha256": {
      "const": "07bafdd9e6251d669b5416a2727b52335c6f37a639784effd2409cc375c667c3"
    },
    "failure_diagnostic": {"$ref": "#/$defs/failureDiagnostic"},
    "bootstrap": {"$ref": "#/$defs/bootstrapPair"},
    "downstream_status": {"$ref": "#/$defs/downstream"},
    "outputs": {"$ref": "#/$defs/outputs"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "started_at": {"const": "2026-07-24T00:14:28+0800"},
    "failed_at": {"const": "2026-07-24T00:37:13+0800"},
    "next_responsible_actor": {"const": "ARTICLE_CONTROL_PLANE"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "task_sha256", "task_contract", "sap_id",
        "sap_sha256", "dataset_id", "dataset_sha256",
        "authorization_id", "authorization_sha256", "dispatch_id",
        "model_entry_receipt_id", "model_entry_receipt_sha256",
        "consumed_ledger_sha256", "readiness_receipt_sha256",
        "runtime_task_sha256", "implementation_commit",
        "repair_implementation_commit"
      ],
      "properties": {
        "task_id": {
          "const": "TASK.CVCC-PRED-ISO-001.FORMAL-FG.V4"
        },
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "task_contract": {
          "const": "formal-temporal-fine-gray-task@2.0.0"
        },
        "sap_id": {"const": "SAP.CVCC-PRED-ISO-001.FROZEN.V3"},
        "sap_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_id": {
          "const": "DATASET.CVCC-PRED-ISO-001.ANALYSIS-READY.V2"
        },
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_id": {
          "const": "AUTH.CVCC-PRED-ISO-001.FORMAL-EXECUTION.V7"
        },
        "authorization_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_id": {
          "const": "DISPATCH.CVCC-PRED-ISO-001.FORMAL-EXECUTION.V7"
        },
        "model_entry_receipt_id": {
          "const": "RECEIPT.CVCC-PRED-ISO-001.FORMAL-MODEL-ENTRY.V7"
        },
        "model_entry_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "consumed_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_task_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_commit": {
          "const": "ede21ea04ed61225117825071ad58ea99ab83761"
        },
        "repair_implementation_commit": {
          "const": "d4a02562032f2e03a3fd7742ab4b04e994b18936"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_attempt", "authorization_attempt", "max_run_attempts",
        "attempt_marker_written", "authorization_consumed", "retry_allowed"
      ],
      "properties": {
        "overall_attempt": {"const": 7},
        "authorization_attempt": {"const": 1},
        "max_run_attempts": {"const": 1},
        "attempt_marker_written": {"const": true},
        "authorization_consumed": {"const": true},
        "retry_allowed": {"const": false}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_entry_called", "stages",
        "dataset_sha256_reverified_after_failure"
      ],
      "properties": {
        "formal_entry_called": {"const": true},
        "stages": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/stageDataSemantics"},
            {"$ref": "#/$defs/stageImputation"},
            {"$ref": "#/$defs/stagePrimaryFit"},
            {"$ref": "#/$defs/stageInternalBootstrap"},
            {"$ref": "#/$defs/stageValidationBootstrap"},
            {"$ref": "#/$defs/stageCalibrationGate"},
            {"$ref": "#/$defs/stageSensitivity"},
            {"$ref": "#/$defs/stageResultValidation"},
            {"$ref": "#/$defs/stageBundleWrite"}
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "dataset_sha256_reverified_after_failure": {"const": true}
      }
    },
    "stageBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "status"],
      "properties": {
        "stage_id": {"type": "string"},
        "status": {"enum": ["COMPLETE", "FAILED", "NOT_STARTED"]}
      }
    },
    "stageDataSemantics": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "DATA_SEMANTICS"},
          "status": {"const": "COMPLETE"}
        }}
      ]
    },
    "stageImputation": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "IMPUTATION"},
          "status": {"const": "COMPLETE"}
        }}
      ]
    },
    "stagePrimaryFit": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "PRIMARY_FIT"},
          "status": {"const": "FAILED"}
        }}
      ]
    },
    "stageInternalBootstrap": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "INTERNAL_BOOTSTRAP"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "stageValidationBootstrap": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "VALIDATION_BOOTSTRAP"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "stageCalibrationGate": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "CALIBRATION_GATE"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "stageSensitivity": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "SENSITIVITY"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "stageResultValidation": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "RESULT_VALIDATION"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "stageBundleWrite": {
      "allOf": [
        {"$ref": "#/$defs/stageBase"},
        {"properties": {
          "stage_id": {"const": "BUNDLE_WRITE"},
          "status": {"const": "NOT_STARTED"}
        }}
      ]
    },
    "bootstrapBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "requested", "completed", "failed", "first_error_code"
      ],
      "properties": {
        "status": {"const": "NOT_STARTED"},
        "requested": {"type": "integer"},
        "completed": {"const": 0},
        "failed": {"const": 0},
        "first_error_code": {"type": "null"}
      }
    },
    "bootstrapInternal": {
      "allOf": [
        {"$ref": "#/$defs/bootstrapBase"},
        {"properties": {"requested": {"const": 1000}}}
      ]
    },
    "bootstrapValidation": {
      "allOf": [
        {"$ref": "#/$defs/bootstrapBase"},
        {"properties": {"requested": {"const": 2000}}}
      ]
    },
    "bootstrapPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "validation"],
      "properties": {
        "internal": {"$ref": "#/$defs/bootstrapInternal"},
        "validation": {"$ref": "#/$defs/bootstrapValidation"}
      }
    },
    "failureDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "aggregate_only",
        "patient_level_payload", "physical_paths_in_diagnostic",
        "failure_stage", "last_completed_stage", "error_code",
        "exception_class", "safe_message", "bootstrap",
        "acceptable_result_generated", "output_manifest_generated",
        "acceptable_bundle_generated"
      ],
      "properties": {
        "schema_version": {
          "const": "formal-temporal-fine-gray-failure-diagnostic@1.2.0"
        },
        "status": {"const": "FAILED"},
        "aggregate_only": {"const": true},
        "patient_level_payload": {"const": false},
        "physical_paths_in_diagnostic": {"const": false},
        "failure_stage": {"const": "PRIMARY_FIT"},
        "last_completed_stage": {"const": "IMPUTATION"},
        "error_code": {"const": "UNEXPECTED_PRIMARY_FIT_FAILURE"},
        "exception_class": {"const": "FORMAL_UNEXPECTED_STAGE_ERROR"},
        "safe_message": {
          "const": "The primary-fit stage failed without an allowlisted detail code."
        },
        "bootstrap": {"$ref": "#/$defs/bootstrapPair"},
        "acceptable_result_generated": {"const": false},
        "output_manifest_generated": {"const": false},
        "acceptable_bundle_generated": {"const": false}
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_gate", "decision_curve",
        "clinical_utility_claim_allowed", "sensitivities"
      ],
      "properties": {
        "calibration_gate": {
          "const": "NOT_EVALUATED_PRIMARY_FIT_FAILURE"
        },
        "decision_curve": {
          "const": "NOT_GENERATED_PRIMARY_FIT_FAILURE"
        },
        "clinical_utility_claim_allowed": {"const": false},
        "sensitivities": {"const": "NOT_STARTED"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_contract", "output_manifest_contract",
        "structured_result_sha256", "output_manifest_sha256",
        "bundle_sha256", "artifact_checksums",
        "acceptable_result_generated", "output_manifest_generated",
        "acceptable_bundle_generated"
      ],
      "properties": {
        "result_contract": {
          "const": "formal-temporal-fine-gray-result@2.0.0"
        },
        "output_manifest_contract": {
          "const": "formal-temporal-fine-gray-output-manifest@1.1.0"
        },
        "structured_result_sha256": {"type": "null"},
        "output_manifest_sha256": {"type": "null"},
        "bundle_sha256": {"type": "null"},
        "artifact_checksums": {
          "type": "array",
          "maxItems": 0,
          "items": false
        },
        "acceptable_result_generated": {"const": false},
        "output_manifest_generated": {"const": false},
        "acceptable_bundle_generated": {"const": false}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_only", "patient_level_payload",
        "patient_data_rows_output", "physical_paths_present",
        "row_level_logs_present", "external_transfer"
      ],
      "properties": {
        "aggregate_only": {"const": true},
        "patient_level_payload": {"const": false},
        "patient_data_rows_output": {"const": 0},
        "physical_paths_present": {"const": false},
        "row_level_logs_present": {"const": false},
        "external_transfer": {"const": false}
      }
    }
  }
}
