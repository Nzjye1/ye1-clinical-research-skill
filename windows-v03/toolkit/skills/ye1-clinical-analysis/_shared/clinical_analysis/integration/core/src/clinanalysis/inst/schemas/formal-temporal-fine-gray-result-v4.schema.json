        "sap_sha256": {"const": "2f291c79486422d474eeaa97c2b6a8fd94dfd140b4050f463b71b21003f0f515"},
        "dataset_id": {"const": "DATASET.CVCC-PRED-ISO-001.ANALYSIS-READY.V2"},
