    {
      "properties": {
        "calibration_gate": {"properties": {"conditions": {"const": {"oe_ratio": true, "calibration_slope": true, "ici": true, "decile_absolute_error": true}}, "all_passed": {"const": true}, "dca_status": {"const": "GENERATED"}, "clinical_utility_claim_allowed": {"const": true}}},
        "decision_curve": {"properties": {"status": {"const": "GENERATED"}, "rows": {"minItems": 5, "maxItems": 5}}},
        "clinical_utility_claim_allowed": {"const": true}
      }
    },
    {
      "properties": {
        "calibration_gate": {"properties": {"conditions": {"not": {"const": {"oe_ratio": true, "calibration_slope": true, "ici": true, "decile_absolute_error": true}}}, "all_passed": {"const": false}, "dca_status": {"const": "NOT_GENERATED_GATE_FAILED"}, "clinical_utility_claim_allowed": {"const": false}}},
        "decision_curve": {"properties": {"status": {"const": "NOT_GENERATED_GATE_FAILED"}, "rows": {"maxItems": 0}}},
        "clinical_utility_claim_allowed": {"const": false}
      }
