{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/clinanalysis/categorical-gcomp-formal-execution-binding@1.0.0.schema.json",
  "title": "Categorical g-comp formal execution binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_sha256",
    "authorization_id",
    "authorization_sha256",
    "candidate_id"
  ],
  "properties": {
    "schema_version": {"const": "categorical-gcomp-formal-execution-binding@1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_id": {"type": "string", "minLength": 1}
  }
}
