  "private_artifact_names": ["frozen_cox_model.json", "individual_predictions.csv", "censoring_grid.json", "individual_ipcw.json"],
  "field_rules": {
    "public_record": "Only record may be projected to public output; all other payload fields and private artifacts remain local/private.",
    "ids": "R adds result_id values; the numerical record contains no run_id, subject_id, identity namespace, model contents, observed-time grid, or individual risk thresholds.",
    "status": "completed, partial, or unavailable. A horizon is unavailable on positivity/weight failure; otherwise partial if AUC or any calibration bin is unavailable. Record status summarizes horizons; reasons are stable codes.",
    "metric_status": "completed or unavailable; unavailable estimates have null value and a reason. Valid numerator/denominator remain reported when independently defined.",
    "uncertainty": "Always not_implemented; no confidence intervals, calibration fit, or p-values.",
    "roc": "above_all endpoint first with threshold null, then fixed_grid thresholds in descending order. Positive means p >= threshold. Entire ROC unavailable if no cases or controls.",
    "calibration": "Fixed [lower,upper) bins, final right-inclusive. Mean predicted risk includes every bin subject. observed_risk=sum_case_weights/sum_weights; small, empty, or zero-weight bins have null observed_risk.",
    "dca": "Positive means p >= threshold; both weighted net-benefit numerators divide by population_denominator=n. Treat-none is null if the whole horizon is unavailable, otherwise zero.",
    "weights": "Raw IPCW sums, never normalized or clipped. Finite below-positivity-guard weights may be reported for diagnosis while metrics remain null. Zero weight sum gives null ESS.",
    "case_control_score_ties": "Actual number of case/control pairs having exactly equal frozen risk; no score rounding.",
    "identity_checks": "weight_mass_minus_n=sum_weights-n; km_identity_difference=weighted_case_probability-km_event_probability. Check with atol=rtol=1e-10, never renormalize. A failed numerical identity rejects the response.",
    "n_at_risk_before_horizon": "count(U >= horizon); includes events and censors exactly at horizon.",
    "counts_partition": "n_cases+n_controls+n_censored_by_horizon=n, with cases delta=1 and U<=t, controls U>t, early censor delta=0 and U<=t."
  },
  "options_example": {
