{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/clinanalysis/candidate-analysis-capability-acceptance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_contract",
    "status",
    "contract_id",
    "contract_sha256",
    "source_module_id",
    "source_module_commit",
    "target_module_id",
    "target_module_commit",
    "capability_registry_sha256",
    "task_schema_id_and_sha256",
    "result_schema_ids_and_sha256",
    "requirement_status_for_REQ1_through_REQ12",
    "test_commands",
    "test_counts",
    "synthetic_only",
    "patient_level_data_read",
    "model_run_on_real_data",
    "materialization_authorized",
    "formal_execution_authorized"
  ],
  "properties": {
    "receipt_contract": {
      "const": "candidate_analysis_capability_acceptance@1.0.0"
    },
    "status": {"enum": ["ACCEPTED", "BLOCKED"]},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_module_id": {"const": "research-topic-module"},
    "source_module_commit": {"$ref": "#/$defs/git_commit"},
    "target_module_id": {"const": "clinical-analysis-module"},
    "target_module_commit": {"$ref": "#/$defs/git_commit"},
    "capability_registry_sha256": {"$ref": "#/$defs/sha256"},
    "task_schema_id_and_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "sha256"],
      "properties": {
        "schema_id": {
          "const": "categorical-transfer-gcomp-task@1.0.0"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result_schema_ids_and_sha256": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_id", "sha256"],
        "properties": {
          "schema_id": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "requirement_status_for_REQ1_through_REQ12": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "REQ1_TASK_CONTRACT",
        "REQ2_CATEGORICAL_STANDARDIZATION",
        "REQ3_UNADJUSTED_WILSON_RISK",
        "REQ4_ROBUST_LOGISTIC_G_COMPUTATION",
        "REQ5_PAIRED_RISK_DIFFERENCE_DRAWS",
        "REQ6_EMPTY_SOURCE_FAIL_CLOSED",
        "REQ7_TWO_EXACT_REFITS",
        "REQ8_FIRST_EVENT_COMPOSITION",
        "REQ9_CREDIBILITY_RESULT",
        "REQ10_FAILURE_AND_PRIVACY",
        "REQ11_RESULT_CONTRACT",
        "REQ12_AUTHORITY_SEPARATION"
      ],
      "properties": {
        "REQ1_TASK_CONTRACT": {"enum": ["PASS", "FAIL"]},
        "REQ2_CATEGORICAL_STANDARDIZATION": {"enum": ["PASS", "FAIL"]},
        "REQ3_UNADJUSTED_WILSON_RISK": {"enum": ["PASS", "FAIL"]},
        "REQ4_ROBUST_LOGISTIC_G_COMPUTATION": {"enum": ["PASS", "FAIL"]},
        "REQ5_PAIRED_RISK_DIFFERENCE_DRAWS": {"enum": ["PASS", "FAIL"]},
        "REQ6_EMPTY_SOURCE_FAIL_CLOSED": {"enum": ["PASS", "FAIL"]},
        "REQ7_TWO_EXACT_REFITS": {"enum": ["PASS", "FAIL"]},
        "REQ8_FIRST_EVENT_COMPOSITION": {"enum": ["PASS", "FAIL"]},
        "REQ9_CREDIBILITY_RESULT": {"enum": ["PASS", "FAIL"]},
        "REQ10_FAILURE_AND_PRIVACY": {"enum": ["PASS", "FAIL"]},
        "REQ11_RESULT_CONTRACT": {"enum": ["PASS", "FAIL"]},
        "REQ12_AUTHORITY_SEPARATION": {"enum": ["PASS", "FAIL"]}
      }
    },
    "test_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "test_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "synthetic_only": {"const": true},
    "patient_level_data_read": {"const": false},
    "model_run_on_real_data": {"const": false},
    "materialization_authorized": {"const": false},
    "formal_execution_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
