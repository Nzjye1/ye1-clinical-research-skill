{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/clinanalysis/categorical-transfer-gcomp-task-v1.2.schema.json",
  "title": "Categorical transfer-source logistic g-computation task v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "analysis_id",
    "execution_mode",
    "source_module_id",
    "target_module_id",
    "authority",
    "binding",
    "data",
    "analysis",
    "outputs",
    "tfl"
  ],
  "properties": {
    "schema_version": {"const": "categorical-transfer-gcomp-task@1.2.0"},
    "task_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["SYNTHETIC_TEST", "FORMAL"]},
    "source_module_id": {"const": "research-topic-module"},
    "target_module_id": {"const": "clinical-analysis-module"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sap_frozen",
        "task_issued",
        "materialization_authorized",
        "formal_execution_authorized"
      ],
      "properties": {
        "sap_frozen": {"type": "boolean"},
        "task_issued": {"type": "boolean"},
        "materialization_authorized": {"type": "boolean"},
        "formal_execution_authorized": {"type": "boolean"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_sha256",
        "sap_id",
        "sap_sha256",
        "capability_contract_id",
        "capability_contract_sha256",
        "value_set_id",
        "value_set_sha256",
        "formal_authorization"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "sap_id": {"type": "string", "minLength": 1},
        "sap_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "capability_contract_id": {"type": "string", "minLength": 1},
        "capability_contract_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "value_set_id": {"type": "string", "minLength": 1},
        "value_set_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "formal_authorization": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "scope",
                "candidate_id",
                "sap_sha256",
                "dataset_sha256"
              ],
              "properties": {
                "reference": {"type": "string", "minLength": 1},
                "scope": {"const": "FORMAL_ANALYSIS_EXECUTION"},
                "candidate_id": {"type": "string", "minLength": 1},
                "sap_sha256": {"$ref": "#/$defs/prefixed_sha256"},
                "dataset_sha256": {"$ref": "#/$defs/prefixed_sha256"}
              }
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "sha256", "dataset_tag"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "dataset_tag": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "record_id",
        "outcome",
        "exposure",
        "exposure_levels",
        "reference",
        "covariates",
        "binary_covariates",
        "sensitivity_source_field",
        "first_event",
        "first_event_levels",
        "first_event_tie_priority",
        "formula",
        "family",
        "link",
        "estimator",
        "variance_method",
        "standardization",
        "draw_distribution",
        "draw_count",
        "seed",
        "interval_method",
        "confidence_level",
        "complete_case",
        "sensitivity_ids",
        "expected_output_ids",
        "full_article_target_id",
        "full_article_profile_checksum",
        "planned_display_contract_id",
        "planned_display_contract_sha256",
        "prior_result_exposure",
        "confirmatory_claim_allowed"
      ],
      "properties": {
        "method": {"const": "categorical_logistic_g_computation"},
        "record_id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "exposure": {"type": "string", "minLength": 1},
        "exposure_levels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "reference": {"type": "string", "minLength": 1},
        "covariates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "binary_covariates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "sensitivity_source_field": {"type": "string", "minLength": 1},
        "first_event": {"type": "string", "minLength": 1},
        "first_event_levels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "first_event_tie_priority": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "formula": {"type": "string", "minLength": 1},
        "family": {"const": "binomial"},
        "link": {"const": "logit"},
        "estimator": {"const": "maximum_likelihood"},
        "variance_method": {"const": "HC0"},
        "standardization": {"const": "ALL_COMPLETE_CASE_ROWS_PAIRED"},
        "draw_distribution": {"const": "MULTIVARIATE_NORMAL_ROBUST_COEFFICIENTS"},
        "draw_count": {"const": 2000},
        "seed": {"const": 80320260724},
        "interval_method": {"const": "PERCENTILE_95"},
        "confidence_level": {"const": 0.95},
        "complete_case": {"const": true},
        "sensitivity_ids": {
          "const": [
            "S1_RECENT_PRIOR_TRANSFER_1H",
            "S2_EXCLUDE_OTHER_ICU"
          ]
        },
        "expected_output_ids": {
          "const": [
            "OUT_COHORT",
            "OUT_PRIMARY_UNADJUSTED",
            "OUT_PRIMARY_ADJUSTED",
            "OUT_DEEPENING",
            "OUT_CREDIBILITY",
            "OUT_DIAGNOSTICS",
            "TABLE1",
            "TABLE_PRIMARY_ESTIMATES",
            "TABLE_DEEPENING_CREDIBILITY",
            "FIGURE_COHORT_FLOW",
            "FIGURE_PRIMARY_EFFECT",
            "FIGURE_CLINICAL_DEEPENING_FIRST_EVENT_COMPOSITION"
          ]
        },
        "full_article_target_id": {
          "const": "ARTICLE_TARGET.FULL_ORIGINAL_APPROX_SCI6.V1"
        },
        "full_article_profile_checksum": {"$ref": "#/$defs/prefixed_sha256"},
        "planned_display_contract_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "planned_display_contract_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "prior_result_exposure": {"type": "boolean"},
        "confirmatory_claim_allowed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prior_result_exposure": {"const": true}
            },
            "required": ["prior_result_exposure"]
          },
          "then": {
            "properties": {
              "confirmatory_claim_allowed": {"const": false}
            }
          }
        }
      ]
    },
    "outputs": {
      "const": {
        "aggregate_only": true,
        "patient_level_output": false,
        "physical_paths_in_output": false,
        "validate_complete_bundle_before_write": true
      }
    },
    "tfl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table1"],
      "properties": {
        "table1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "group", "variables"],
          "properties": {
            "enabled": {"const": true},
            "group": {"type": "string", "minLength": 1},
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "label", "type"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "label": {"type": "string", "minLength": 1},
                  "type": {
                    "enum": ["continuous", "categorical", "binary"]
                  },
                  "summary": {
                    "oneOf": [
                      {"const": "mean_sd"},
                      {"const": "median_iqr"},
                      {"type": "null"}
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
