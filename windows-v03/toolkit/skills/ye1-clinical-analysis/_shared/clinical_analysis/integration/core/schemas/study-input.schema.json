    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "estimand": {
      "type": "string",
      "minLength": 1
    },
    "protocol_revision": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "database": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "recipe_version": {
            "type": "string",
            "minLength": 1
          },
          "recipe_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_refs": {
            "type": "array",
