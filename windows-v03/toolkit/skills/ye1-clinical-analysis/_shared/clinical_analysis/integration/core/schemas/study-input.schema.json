          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "column_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
            }
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "minItems": 1
          },
          "joins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cardinality": {
                  "type": "string",
                  "minLength": 1
                },
                "left_unique": {
                  "type": "boolean"
                },
                "right_unique": {
                  "type": "boolean"
                },
                "rows_before": {
                  "type": "integer",
                  "minimum": 0
                },
                "rows_after": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "cardinality",
                "left_unique",
                "right_unique",
                "rows_before",
                "rows_after",
                "evidence_ref"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "transformation_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "counts_ref": {
            "type": "string",
            "minLength": 1
          },
          "location_policy": {
            "enum": [
              "project_local",
              "explicit_bound_external"
            ]
          },
          "format": {
            "enum": [
              "csv",
              "csv_gzip"
            ]
          },
          "unselected_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "order_by"
            ],
            "properties": {
              "kind": {
                "const": "engineering_one_record_per_subject"
              },
              "order_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "view_id",
          "kind",
          "source_ids",
          "local_ref",
          "content_hash",
          "column_map",
          "grain",
          "keys",
          "joins",
          "transformation_hash",
          "counts_ref",
          "format",
          "unselected_columns"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "analysis": {
      "type": "object",
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
