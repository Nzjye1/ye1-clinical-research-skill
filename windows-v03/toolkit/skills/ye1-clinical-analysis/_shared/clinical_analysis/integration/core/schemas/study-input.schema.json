        "subject_key",
        "record_keys",
        "scope",
        "analysis_unit",
        "repeated_policy",
        "encounter_key",
        "cluster_key"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "dtype": {
            "enum": [
              "id",
              "number",
              "category"
            ]
          },
          "role": {
            "enum": [
              "id",
              "exposure",
              "covariate",
              "group",
              "outcome",
              "split",
              "time",
              "descriptive_measure",
              "stratification_label",
              "outcome_summary"
