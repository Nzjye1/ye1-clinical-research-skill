                "key": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "minItems": 1
                },
                "subject_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "event": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "non_event": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "nonlinear": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "method": {
                          "const": "restricted_cubic"
                        },
                        "knots": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3
                        }
                      },
                      "required": [
                        "method",
                        "knots"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subgroup": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                        },
                        "levels": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 2
                        },
                        "reference": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "field",
                        "levels",
                        "reference"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sensitivity": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1
                      },
                      "where": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                            },
                            "op": {
                              "enum": [
                                "eq",
                                "ne",
                                "lt",
                                "le",
                                "gt",
                                "ge",
                                "in"
                              ]
                            },
                            "value": {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "array"
                              ]
                            }
                          },
                          "required": [
                            "field",
                            "op",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "covariates": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                        },
                        "minItems": 0
                      },
                      "nonlinear": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "method": {
                                "const": "restricted_cubic"
                              },
                              "knots": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "minItems": 3
                              }
                            },
                            "required": [
                              "method",
                              "knots"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "covariance": {
                        "enum": [
                          "HC3",
                          "classical",
                          "model",
                          "HC0"
                        ]
                      }
                    },
                    "required": [
                      "label",
                      "rationale",
                      "where"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "model",
                "outcome",
                "exposure",
                "covariates",
                "missing",
                "covariance",
                "categorical",
                "row_unit",
                "independent",
                "key",
                "subject_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "group": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "variables": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                      },
                      "type": {
                        "enum": [
                          "continuous",
                          "categorical",
                          "binary"
                        ]
                      },
                      "summary": {
                        "enum": [
                          "mean_sd",
                          "median_iqr",
                          null
                        ]
                      },
                      "levels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "name",
                      "type",
                      "summary",
                      "levels"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "categorical_denominator": {
                  "enum": [
                    "nonmissing",
                    "all"
                  ]
                },
                "include_overall": {
                  "type": "boolean"
                }
              },
              "required": [
                "group",
                "variables",
                "categorical_denominator",
                "include_overall"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_scale": {
          "type": "string",
          "minLength": 1
        },
        "variance": {
          "type": "string",
          "minLength": 1
        },
        "ci_level": {
          "type": "number"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "method_id",
        "required_view_ids",
        "spec",
        "baseline",
        "effect_scale",
        "variance",
        "ci_level",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "missingness": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "fit_scope": {
          "type": "string",
          "minLength": 1
        },
        "exclusion_denominator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strategy",
        "fit_scope",
        "exclusion_denominator"
      ],
