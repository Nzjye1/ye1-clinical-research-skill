          "name",
          "dtype",
          "role",
          "unit",
          "source_unit",
          "dimension",
          "conversion",
          "levels",
          "reference",
          "codes",
          "missing_codes",
          "occurred_at",
          "available_at",
          "concept",
          "codebook_version",
          "aggregation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "cohort": {
      "type": "object",
      "properties": {
        "target_population": {
          "type": "string",
          "minLength": 1
        },
        "inclusion": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusion": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "index_event": {
          "type": "string",
          "minLength": 1
        },
        "selection_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "target_population",
        "inclusion",
        "exclusion",
        "index_event",
        "selection_order"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": [
            "number",
            "null"
          ]
        },
        "feature_cutoff": {
          "type": [
            "number",
            "null"
          ]
        },
        "outcome_window": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "label_mature_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "analysis_as_of": {
          "type": [
            "number",
            "null"
          ]
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "delayed_entry": {
          "type": "boolean"
        },
        "policy": {
          "enum": [
            "descriptive_snapshot",
            "cross_sectional_association",
            "ordered_observation"
          ]
        }
      },
      "required": [
        "unit",
        "timezone",
        "index",
        "feature_cutoff",
        "outcome_window",
        "label_mature_at",
        "analysis_as_of",
        "boundary",
        "delayed_entry",
        "policy"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "event": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "non_event": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "censoring": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "field",
            "type",
            "event",
            "non_event",
            "definition",
            "censoring"
          ],
          "additionalProperties": false
        }
      ]
    },
    "design": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "inference_unit": {
          "type": "string",
          "minLength": 1
        },
        "variance_unit": {
          "type": "string",
          "minLength": 1
        },
        "strata": {
          "type": [
            "string",
            "null"
          ]
        },
        "psu": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "inference_unit",
        "variance_unit",
        "strata",
        "psu",
        "domain"
      ],
      "additionalProperties": false
    },
    "weights": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "construction": {
          "type": [
            "string",
            "null"
          ]
        },
        "variance_semantics": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "field",
        "target",
        "construction",
        "variance_semantics"
      ],
      "additionalProperties": false
