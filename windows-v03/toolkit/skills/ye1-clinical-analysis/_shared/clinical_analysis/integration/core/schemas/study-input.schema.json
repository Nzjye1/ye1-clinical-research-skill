            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "occurred_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "available_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "codebook_version": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "const": "already_one_value_per_row"
          }
