          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source_unit": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "conversion": {
            "type": "object",
