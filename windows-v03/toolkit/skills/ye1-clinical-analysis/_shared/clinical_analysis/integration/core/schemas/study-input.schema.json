              "user_clinical_file",
              "public_clinical_extract",
              "synthetic_fixture"
            ]
          }
        },
        "required": [
          "source_id",
          "database",
          "snapshot",
          "period",
          "recipe_version",
          "recipe_hash",
          "source_fingerprint",
          "evidence_refs",
          "verification_status",
          "source_kind"
