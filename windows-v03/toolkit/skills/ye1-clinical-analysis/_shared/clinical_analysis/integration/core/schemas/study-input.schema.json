            "additionalProperties": false
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "codes": {
            "type": "object",
