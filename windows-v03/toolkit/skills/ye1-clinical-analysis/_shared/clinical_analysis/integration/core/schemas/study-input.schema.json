{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinical-study-input@1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "clinical-study-input@1.0"
    },
    "study_id": {
